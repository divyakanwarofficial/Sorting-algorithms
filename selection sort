#include <iostream>
using namespace std;

int main()
{
    int arr[5] = {5, 4, 3, 2, 1};
    int n = 5;

    for(int i = 0; i < n - 1; i++)
    {
        int min_index_element = i;

        for(int j = i + 1; j < n; j++)
        {
            if(arr[j] < arr[min_index_element])
            {
                min_index_element = j;
            }
        }

        swap(arr[i], arr[min_index_element]);
    }

    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
